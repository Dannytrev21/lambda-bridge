# AWS Lambda Event Forwarder Configuration

# Required: SNS topic ARN for forwarding SNS events
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:your-topic-name

# Required: Comma-separated list of webhook URLs for ALB event forwarding
WEBHOOK_URLS=https://webhook1.example.com/webhook,https://webhook2.example.com/webhook,https://webhook3.example.com/webhook

# Optional: Skip forwarding health check requests (default: true)
SKIP_HEALTH_CHECKS=true

# Optional: Environment name for logging (default: dev)
ENVIRONMENT=dev

# Optional: Enable debug logging (default: false)
DEBUG=false

# AWS Configuration (handled by Lambda runtime)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...